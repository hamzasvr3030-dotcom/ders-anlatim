    },
    {
      "konu": "16-formul-ozeti",
      "on": "Faiz faktörleri: $(A/P,i,n)$",
      "arka": "$\\dfrac{i(1 + i)^n}{(1 + i)^n - 1}$"
    },
    {
      "konu": "16-formul-ozeti",
      "on": "Faiz faktörleri: $(P/A,i,n)$",
      "arka": "$\\dfrac{(1 + i)^n - 1}{i(1 + i)^n}$"
