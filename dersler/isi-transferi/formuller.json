{
  "kartlar": [
    {
      "konu": "11-formul-ozeti",
      "on": "İletim: Fourier",
      "arka": "$\\dot Q = -kA\\dfrac{dT}{dx}$, $\\;q = -k\\dfrac{dT}{dx}$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "İletim: Düzlem duvar",
      "arka": "$\\dot Q = kA\\dfrac{T_1 - T_2}{L}$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "İletim: Isı iletim denklemi",
      "arka": "$\\nabla^2T + \\dfrac{\\dot g}{k} = \\dfrac{1}{\\alpha}\\dfrac{\\partial T}{\\partial t}$, $\\;\\alpha = \\dfrac{k}{\\rho c}$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "İletim: Radyal genel form",
      "arka": "$\\dfrac{1}{r^n}\\dfrac{\\partial}{\\partial r}\\left(r^nk\\dfrac{\\partial T}{\\partial r}\\right) + \\dot g = \\rho c\\dfrac{\\partial T}{\\partial t}$ ($n = 0, 1, 2$)"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Isıl dirençler: Düzlem duvar",
      "arka": "$R = L/(kA)$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Isıl dirençler: Silindir",
      "arka": "$R = \\ln(r_2/r_1)/(2\\pi kL)$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Isıl dirençler: Taşınım",
      "arka": "$R = 1/(hA)$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Isıl dirençler: Seri",
      "arka": "$R_{top} = \\sum R_i$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Isıl dirençler: Paralel",
      "arka": "$1/R_{top} = \\sum 1/R_i$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Isıl dirençler: Isı geçişi",
      "arka": "$\\dot Q = \\Delta T/R_{top}$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Silindir ve kritik yarıçap: Isı üretimli tel",
      "arka": "$T(r) = \\dfrac{\\dot g(a^2 - r^2)}{4k} + \\dfrac{\\dot ga}{2h} + T_\\infty$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Silindir ve kritik yarıçap: Boş silindir",
      "arka": "$\\dfrac{T - T_1}{T_2 - T_1} = \\dfrac{\\ln(r/a)}{\\ln(b/a)}$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Silindir ve kritik yarıçap: Kritik yarıçap",
      "arka": "Silindir $r_{kr} = k/h$, küre $r_{kr} = 2k/h$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Kanatçıklar ($m = \\sqrt{hP/(kA)}$, $\\theta_d = T_d - T_\\infty$): Sonsuz uzun",
      "arka": "$\\theta/\\theta_d = e^{-mx}$ · $\\theta_d\\sqrt{hPkA}$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Kanatçıklar ($m = \\sqrt{hP/(kA)}$, $\\theta_d = T_d - T_\\infty$): Ucu yalıtılmış",
      "arka": "$\\theta/\\theta_d = \\dfrac{\\cosh m(L-x)}{\\cosh mL}$ · $\\theta_d\\sqrt{hPkA}\\tanh mL$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Kanatçıklar ($m = \\sqrt{hP/(kA)}$, $\\theta_d = T_d - T_\\infty$): Uçta taşınım",
      "arka": "$L_c = L + A/P$ ile yalıtılmış uç"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Kanatçıklar ($m = \\sqrt{hP/(kA)}$, $\\theta_d = T_d - T_\\infty$): Verim",
      "arka": "$\\eta = \\dot Q_{kanat}/[hA_{kanat}(T_d - T_\\infty)]$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Kanatçıklar ($m = \\sqrt{hP/(kA)}$, $\\theta_d = T_d - T_\\infty$): Etkinlik",
      "arka": "$\\varepsilon = \\dot Q_{kanatlı}/\\dot Q_{kanatsız}$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Zamana bağlı iletim: Biot, Fourier",
      "arka": "$Bi = hL_c/k$, $\\;Fo = \\alpha t/L_c^2$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Zamana bağlı iletim: Toplu sistem ($Bi < 0{,}1$)",
      "arka": "$\\dfrac{T - T_\\infty}{T_i - T_\\infty} = e^{-Bi\\,Fo} = e^{-\\frac{hA_s}{\\rho Vc}t}$, $\\;L_c = V/A_s$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Zamana bağlı iletim: Tek terim (merkez)",
      "arka": "$\\theta_0 = A_1e^{-\\lambda_1^2Fo}$ ($Fo > 0{,}2$)"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Zamana bağlı iletim: Levha konum",
      "arka": "$\\theta = \\theta_0\\cos(\\lambda_1x/L)$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Zamana bağlı iletim: Silindir konum",
      "arka": "$\\theta = \\theta_0J_0(\\lambda_1r/r_0)$"
    },
    {
      "konu": "11-formul-ozeti",
      "on": "Zamana bağlı iletim: Q₀",
      "arka": "$\\rho cV(T_i - T_\\infty)$"
    }
  ]
}
