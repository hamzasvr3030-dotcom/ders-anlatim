      "on": "Kontrol hacmi: Karışma",
      "arka": "$\\sum\\dot m_g h_g = \\sum\\dot m_ç h_ç$"
    },
    {
      "konu": "08-formul-ozeti",
      "on": "Kontrol hacmi: Zamana bağlı",
      "arka": "$Q - W + \\sum m_gh_g - \\sum m_çh_ç = m_2u_2 - m_1u_1$"
